# GEMINI_API_KEY: Required for Gemini AI API calls (optional for StructStock inventory).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted frontend URL (AI Studio / Cloud Run). Optional for local npm run dev.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# StructStock API base URL (React → .NET)
# ---------------------------------------------------------------------------
# LOCAL DEV (recommended): leave UNSET or use relative path so Vite proxies
# /api and /hubs to http://localhost:5080 (see vite.config.ts).
#
#   VITE_API_BASE_URL=/api/v1
#
# Do NOT point this at a Vercel URL for login. Vercel only hosts the static
# React app; the .NET API + SQL Server must run locally (or on a real host).
# If you set an absolute Vercel /api URL, login will fail because that route
# still targets the legacy Express serverless stub (api/index.ts).
#
# VITE_API_BASE_URL=/api/v1
